---
import '../styles/site.css';
import frauncesUrl from '../assets/fonts/fraunces-latin-full-normal.woff2?url';
import { asset } from '../lib/paths';
import { buildCsp } from '../../scripts/security-headers.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  admin?: boolean;
}

const { title, description, noindex = false, jsonLd, admin = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(asset('og.jpg'), Astro.site);

// Hospedagens sem cabeçalhos HTTP próprios (GitHub Pages) recebem a CSP por <meta>.
// No Cloudflare isso fica desligado: a política completa vem do arquivo _headers.
const cspMeta =
  import.meta.env.PUBLIC_CSP_META === 'true'
    ? buildCsp({ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, admin, meta: true })
    : null;

// JSON-LD é bloco de dados (não executa). Ainda assim, escapamos "<" para
// impedir que um texto do banco feche a tag </script>.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    {cspMeta && <meta http-equiv="Content-Security-Policy" content={cspMeta} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1b4426" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={frauncesUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
  </head>
  <body>
    <slot />
  </body>
</html>
