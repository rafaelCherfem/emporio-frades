---
import Base from '../../layouts/Base.astro';
import '../../styles/admin.css';
---

<Base title="Painel | Empório Frades" description="Área restrita do Empório Frades." noindex>
  <div class="admin">
    <section data-view="loading" class="center">
      <p class="muted">Carregando…</p>
    </section>

    <section data-view="setup" class="center card" hidden>
      <h1 tabindex="-1">Painel ainda não configurado</h1>
      <p>Defina <code>PUBLIC_SUPABASE_URL</code> e <code>PUBLIC_SUPABASE_ANON_KEY</code> e gere o site de novo. O passo a passo está no README do projeto.</p>
    </section>

    <section data-view="login" class="center card" hidden>
      <p class="admin__brand">Empório Frades</p>
      <h1 tabindex="-1">Entrar no painel</h1>
      <form data-login-form class="stack" novalidate>
        <div class="field">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="username" required autofocus maxlength="254" />
        </div>
        <div class="field">
          <label for="password">Senha</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128" />
        </div>
        <p class="form-error" data-login-error role="alert" hidden></p>
        <button class="btn btn--label btn--block" type="submit">Entrar</button>
        <button class="link-btn" type="button" data-forgot>Esqueci a senha</button>
      </form>
    </section>

    <section data-view="recovery" class="center card" hidden>
      <h1 tabindex="-1">Criar nova senha</h1>
      <form data-recovery-form class="stack" novalidate>
        <div class="field">
          <label for="new-password">Nova senha</label>
          <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required autofocus aria-describedby="new-password-help" />
          <p class="field__help" id="new-password-help">Pelo menos 10 caracteres. Uma frase curta funciona bem.</p>
        </div>
        <div class="field">
          <label for="confirm-password">Repita a senha</label>
          <input id="confirm-password" name="confirm" type="password" autocomplete="new-password" maxlength="128" required />
        </div>
        <p class="form-error" data-recovery-error role="alert" hidden></p>
        <button class="btn btn--label btn--block" type="submit">Salvar nova senha</button>
      </form>
    </section>

    <section data-view="denied" class="center card" hidden>
      <h1 tabindex="-1">Sem acesso ao painel</h1>
      <p>A conta <strong data-denied-email></strong> entrou, mas não tem permissão para editar o site. Peça para quem cuida do site liberar o acesso.</p>
      <button class="btn btn--ghost" type="button" data-denied-logout>Sair</button>
    </section>

    <div data-view="app" class="app" hidden>
      <header class="topbar">
        <p class="admin__brand">Empório Frades <span class="muted">painel</span></p>
        <nav class="tabs" aria-label="Seções do painel">
          <a href="#promotions" data-tab="promotions">Promoções</a>
          <a href="#highlights" data-tab="highlights">Em alta</a>
          <a href="#news" data-tab="news">Novidades</a>
          <a href="#settings" data-tab="settings">Dados da loja</a>
        </nav>
        <div class="topbar__user">
          <a class="btn btn--ghost btn--s" href="/" target="_blank" rel="noopener">Ver site</a>
          <span class="muted topbar__email" data-user-email></span>
          <button class="btn btn--ghost btn--s" type="button" data-logout>Sair</button>
        </div>
      </header>
      <main class="panel" data-panel aria-live="polite"></main>
    </div>

    <dialog class="editor-dialog" data-editor aria-label="Editor"></dialog>
    <div class="toasts" data-toast aria-live="polite"></div>
  </div>

  <script>
    import { initAdmin } from '../../scripts/admin/main';
    initAdmin();
  </script>
</Base>
