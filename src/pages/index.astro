---
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Marquee from '../components/Marquee.astro';
import Seal from '../components/Seal.astro';
import DefaultBanners from '../components/DefaultBanners.astro';
import { demoContent, emptyLists, storeSettings } from '../data/seed';
import Base from '../layouts/Base.astro';
import { fetchContent } from '../lib/api';
import { readConfig } from '../lib/config';
import type { SiteContent } from '../lib/schemas';
import {
  addressLines,
  contactLinks,
  fullAddress,
  bannerSlides,
  productCards,
  hoursList,
  newsCards,
  promotionList,
  socialList,
} from '../lib/views';
import { toHTML } from '../lib/vnode';
import { asset } from '../lib/paths';

const cfg = readConfig();

// Com o banco configurado, o HTML já sai com o conteúdo real do momento do build.
// Sem banco (demonstração), usa o conteúdo de exemplo.
const live = cfg.enabled ? await fetchContent(cfg) : null;
const content: SiteContent = cfg.enabled
  ? {
      settings: live?.settings ?? storeSettings,
      promotions: live?.promotions ?? [...emptyLists.promotions],
      highlights: live?.highlights ?? [...emptyLists.highlights],
      news: live?.news ?? [...emptyLists.news],
      banners: live?.banners ?? [...emptyLists.banners],
    }
  : demoContent;

const s = content.settings;
const links = contactLinks(s);
// "Reservar" dos produtos: WhatsApp se houver, senão telefone
const env = { supabaseUrl: cfg.supabaseUrl, now: new Date(), reserveHref: links.whatsapp ?? links.phone };
const [addr1, addr2] = addressLines(s);
const promos = promotionList(content.promotions, env);
const highlights = productCards(content.highlights, env);
const news = newsCards(content.news, env);
const banners = bannerSlides(content.banners, env);
const year = new Date().getFullYear();

// Conteúdo inicial entregue ao navegador como DADO (application/json, não executa).
const initial = JSON.stringify(content).replace(/</g, '\\u003c');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LiquorStore',
  name: s.name,
  description: s.tagline,
  url: Astro.site?.toString(),
  image: new URL(asset('media/vinhos-960.webp'), Astro.site).toString(),
  telephone: s.phone ? `+55${s.phone}` : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [s.street, s.number].filter(Boolean).join(', '),
    addressLocality: s.city,
    addressRegion: s.state,
    postalCode: s.zip || undefined,
    addressCountry: 'BR',
  },
  geo: s.latitude != null ? { '@type': 'GeoCoordinates', latitude: s.latitude, longitude: s.longitude } : undefined,
  openingHoursSpecification: s.hours
    .filter((h) => !h.closed)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][h.day],
      opens: h.open,
      closes: h.close,
    })),
  sameAs: [links.instagram, links.facebook, links.tiktok].filter(Boolean),
};

const ext = { target: '_blank', rel: 'noopener noreferrer' };

// Letreiro: cada letra vira um elemento para a abertura e o relevo.
// Leitores de tela leem o texto inteiro (sr-only); as letras ficam ocultas para eles.
const signLines = ['Empório', 'Frade’s'].map((w) => [...w]);

// Títulos de seção: cada palavra numa máscara, para a revelação no scroll
const words = (t: string) => t.split(' ');

// Gomos do toldo: suficientes para cobrir telas largas (o excesso fica fora da foto)
const gores = Array.from({ length: 44 }, (_, i) => i);
---

<Base
  title={`${s.name} | Vinhos, cervejas e destilados na Saúde, SP`}
  description={`${s.tagline} ${fullAddress(s)}.`}
  jsonLd={jsonLd}
>
  <noscript><link rel="stylesheet" href={asset('noscript.css')} /></noscript>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>

  {!cfg.enabled && <p class="demo-banner" role="note">Modo demonstração: promoções e produtos são exemplos. Configure o Supabase para editar pelo painel.</p>}

  <header class="header" data-header>
    <div class="wrap header__inner">
      <a class="brand-link" href="#topo" aria-label={`${s.name}, início`}><Logo /></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" data-nav-toggle>
        <span></span><span></span><span></span>
        <span class="sr-only">Menu</span>
      </button>
      <nav class="nav" id="menu" aria-label="Principal" data-nav>
        <ul class="nav__list">
          <li><a href="#promocoes">Promoções</a></li>
          <li><a href="#em-alta">Mais procurados</a></li>
          <li><a href="#novidades">Novidades</a></li>
          <li><a href="#onde-estamos">Onde estamos</a></li>
        </ul>
      </nav>
      <a class="btn btn--label" href={links.whatsapp} data-link="whatsapp" {...ext} hidden={!links.whatsapp}>
        <Icon name="whatsapp" />
        WhatsApp
      </a>
      <a class="btn btn--label" href={links.phone} data-link="phone" data-fallback hidden={!links.phone || !!links.whatsapp}>
        <Icon name="phone" />
        Ligar
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero wrap" id="topo" aria-labelledby="hero-title">
      <h1 class="hero__name" id="hero-title" data-hero-name>
        <span class="sr-only">Empório Frade’s</span>
        {signLines.map((chars, i) => (
          <span class:list={['hero__line', i === 1 && 'hero__line--right']} aria-hidden="true" data-hero-line>
            {chars.map((c) => <span class="hero__char">{c}</span>)}
          </span>
        ))}
      </h1>

      <div class="hero__base" data-hero-base>
        <p class="hero__tagline" data-bind="tagline">{s.tagline}</p>
        <div class="hero__aside">
          <p class="status" data-status hidden></p>
          <p class="hero__address">
            <span data-bind="address1">{addr1}</span>
            {addr2 && <span>, </span>}
            <span data-bind="address2">{addr2}</span>
          </p>
          <div class="hero__actions">
            <a class="btn btn--label" href="#promocoes">Ver promoções</a>
            <a class="btn btn--ghost" href={links.whatsapp} data-link="whatsapp" {...ext} hidden={!links.whatsapp}>
              <Icon name="whatsapp" />
              Chamar no WhatsApp
            </a>
            <a class="btn btn--ghost" href={links.phone} data-link="phone" data-fallback hidden={!links.phone || !!links.whatsapp}>
              <Icon name="phone" />
              <span data-label="phone">{links.phoneLabel}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="storefront-wrap">
    <Seal />
    <section class="vitrine" data-storefront data-vitrine aria-roledescription="carrossel" aria-label="Destaques da loja">
      <div class="valance" aria-hidden="true" data-valance>
        {gores.map(() => <span class="valance__gore"><span></span></span>)}
      </div>
      <div class="vitrine__track" data-list="banners" aria-live="off">
        {banners.length ? <Fragment set:html={toHTML(banners)} /> : <DefaultBanners phoneHref={links.phone} />}
      </div>
      <template data-default-banners><DefaultBanners phoneHref={links.phone} /></template>
      <div class="vitrine__controls" data-vitrine-controls hidden>
        <button class="vitrine__arrow vitrine__arrow--prev" type="button" data-vitrine-prev aria-label="Banner anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="vitrine__dots" data-vitrine-dots></div>
        <button class="vitrine__arrow vitrine__arrow--next" type="button" data-vitrine-next aria-label="Próximo banner">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </section>
    </div>

    <Marquee />

    <section class="promos on-bottle" id="promocoes" aria-labelledby="promos-title" data-promos>
      <div class="wrap promos__head">
        <div>
          <h2 class="section-title" id="promos-title" data-reveal>{words('Promoções da semana').map((w, i) => <>{i > 0 && ' '}<span class="w"><span>{w}</span></span></>)}</h2>
          <p class="section-lead">Preços válidos na loja enquanto durar o estoque. Para reservar, fale com a gente.</p>
        </div>
        <p class="promos__count" data-promo-count aria-live="polite" hidden={promos.length === 0}>
          {promos.length === 1 ? '1 oferta' : `${promos.length} ofertas`}
        </p>
      </div>

      <div class="rail" data-rail hidden={promos.length === 0}>
        <ul class="rail__track" data-list="promotions" aria-label="Ofertas" set:html={toHTML(promos)} />
        <div class="rail__progress" aria-hidden="true"><span data-rail-progress></span></div>
      </div>

      <p class="wrap promos__empty" data-promo-empty hidden={promos.length > 0}>
        As ofertas da semana aparecem aqui assim que forem publicadas. Enquanto isso,
        <a href={links.phone} data-link="phone" hidden={!links.phone}>ligue para a loja</a>
        <span data-link-sep hidden={!links.phone || !links.instagram}>ou</span>
        <a href={links.instagram} data-link="instagram" {...ext} hidden={!links.instagram}>acompanhe o Instagram</a>.
      </p>

      <p class="wrap promos__foot">Venda de bebidas alcoólicas proibida para menores de 18 anos. Beba com moderação.</p>
    </section>

    <section class="hot" id="em-alta" aria-labelledby="hot-title" data-hot hidden={highlights.length === 0}>
      <div class="wrap">
        <div class="shelf-head">
          <h2 class="section-title" id="hot-title" data-reveal>{words('Os mais procurados').map((w, i) => <>{i > 0 && ' '}<span class="w"><span>{w}</span></span></>)}</h2>
          <p class="section-lead">O que a clientela mais tem levado. Para reservar, é só ligar.</p>
        </div>
        <ul class="shelf" data-list="highlights" set:html={toHTML(highlights)} />
      </div>
    </section>

    <section class="about" aria-label="Sobre a loja">
      <div class="wrap about__grid">
        <p class="about__text" data-bind="about">{s.about}</p>
        <figure class="about__photo">
          <img
            src={asset('media/vinhos-960.webp')}
            srcset={`${asset('media/vinhos-560.webp')} 560w, ${asset('media/vinhos-960.webp')} 960w`}
            sizes="(max-width: 860px) 100vw, 40vw"
            width="960"
            height="938"
            alt="Mesa rústica com garrafas de vinho rosé, tinto e lambrusco, diante de prateleiras de vinhos e taças"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="news" id="novidades" aria-labelledby="news-title" data-news hidden={news.length === 0}>
      <div class="wrap">
        <div class="shelf-head">
          <h2 class="section-title" id="news-title" data-reveal>{words('Novidades').map((w, i) => <>{i > 0 && ' '}<span class="w"><span>{w}</span></span></>)}</h2>
          <p class="section-lead">O que acabou de chegar e o que está acontecendo na loja.</p>
        </div>
        <ul class="news-grid" data-list="news" set:html={toHTML(news)} />
      </div>
    </section>

    <section class="visit" id="onde-estamos" aria-labelledby="visit-title">
      <div class="wrap">
        <h2 class="section-title" id="visit-title" data-reveal>{words('Onde estamos').map((w, i) => <>{i > 0 && ' '}<span class="w"><span>{w}</span></span></>)}</h2>

        <div class="visit__grid">
          <div>
            <address class="visit__address">
              <span data-bind="address1">{addr1}</span><br />
              <span data-bind="address2">{addr2}</span>
            </address>
            <p class="visit__ref" data-bind="reference" hidden={!s.reference}>{s.reference}</p>

            <div class="visit__actions">
              <a class="btn btn--label" href={links.maps} data-link="maps" {...ext}>
                <Icon name="route" />
                Como chegar
              </a>
              <a class="btn btn--ghost" href={links.waze} data-link="waze" {...ext}>Abrir no Waze</a>
            </div>

            <div class="hours">
              <h3 class="hours__title">Horário de funcionamento</h3>
              <ul data-list="hours" set:html={toHTML(hoursList(s, env))} />
            </div>

            <div class="contacts">
              <a href={links.phone} data-link="phone" hidden={!links.phone}>
                <Icon name="phone" />
                <span data-label="phone">{links.phoneLabel}</span>
              </a>
              <a href={links.whatsapp} data-link="whatsapp" {...ext} hidden={!links.whatsapp}>
                <Icon name="whatsapp" />
                <span data-label="whatsapp">{links.whatsappLabel}</span>
              </a>
              <a href={links.email} data-link="email" hidden={!links.email}>
                <Icon name="mail" />
                <span data-label="email">{links.emailLabel}</span>
              </a>
            </div>
          </div>

          <div class="map on-bottle" data-map>
            <div class="map__grid" aria-hidden="true"></div>
            <svg class="map__roads" viewBox="0 0 600 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <path d="M-20 300 C 140 260, 260 240, 620 150" stroke="currentColor" stroke-width="26" fill="none" />
              <path d="M180 -20 L 330 440" stroke="currentColor" stroke-width="16" fill="none" />
              <path d="M-20 90 L 620 120" stroke="currentColor" stroke-width="10" fill="none" />
              <path d="M460 -20 C 430 140, 470 300, 420 440" stroke="currentColor" stroke-width="10" fill="none" />
            </svg>
            <Icon name="pin" class="map__pin" />
            <div class="map__cta">
              <p class="map__note">O mapa do Google só é carregado quando você pede.</p>
              <button class="btn btn--label map__load" type="button" data-map-load>Mostrar mapa</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer on-bottle">
    <div class="wrap">
      <p class="footer__name" aria-hidden="true" data-footer-name data-text="Frade’s">{[...'Frade’s'].map((c) => <span class="footer__char">{c}</span>)}</p>
      <div class="footer__grid">
        <div>
          <h2>Endereço</h2>
          <p><span data-bind="address1">{addr1}</span><br /><span data-bind="address2">{addr2}</span></p>
        </div>
        <div>
          <h2>Contato</h2>
          <ul>
            <li><a href={links.phone} data-link="phone" hidden={!links.phone}>Ligar para a loja</a></li>
            <li><a href={links.whatsapp} data-link="whatsapp" {...ext} hidden={!links.whatsapp}>WhatsApp</a></li>
            <li><a href={links.email} data-link="email" hidden={!links.email}>E-mail</a></li>
          </ul>
        </div>
        <div>
          <h2>Redes sociais</h2>
          <ul data-list="social" set:html={toHTML(socialList(s))} />
        </div>
      </div>
      <p class="footer__legal">
        Venda de bebidas alcoólicas proibida para menores de 18 anos. Se beber, não dirija.<br />
        © {year} <span data-bind="name">{s.name}</span>. Preços e ofertas sujeitos a alteração sem aviso e válidos somente na loja física.
      </p>
    </div>
  </footer>

  <a class="btn btn--label float-cta" href={links.whatsapp} data-link="whatsapp" {...ext} data-float-cta data-visible="false" hidden={!links.whatsapp}>
    <Icon name="whatsapp" />
    <span>WhatsApp</span>
  </a>
  <a class="btn btn--label float-cta" href={links.phone} data-link="phone" data-fallback data-float-cta data-visible="false" hidden={!links.phone || !!links.whatsapp}>
    <Icon name="phone" />
    <span>Ligar</span>
  </a>

  <script type="application/json" id="initial-content" is:inline set:html={initial}></script>
  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</Base>
